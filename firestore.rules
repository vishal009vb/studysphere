rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Role helpers ──────────────────────────────────────────────────────────

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isModerator() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator';
    }

    function isContributor() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'contributor';
    }

    function isAdminOrModerator() {
      return isAdmin() || isModerator();
    }

    // ── Auth helpers ──────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── CRITICAL: AI quota fields must NEVER be client-writable ──────────────
    //
    // [C-06 FIX] The actual field names written by gemini_service.dart:1095-1099
    // are 'dailyAiUsage' and 'lastUsageReset'. The old guard checked
    // 'dailyUsageCount'/'lastResetDate' (nonexistent fields), so it was dead code.
    // Clients are now BLOCKED from writing these fields at all — quota enforcement
    // will move server-side to the Edge Function in a follow-up commit.

    function isAttemptingAiQuotaWrite() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['dailyAiUsage', 'lastUsageReset']);
    }

    // ── Input size guards ─────────────────────────────────────────────────────

    function validStringField(field, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() <= maxLen;
    }

    // ── Users Collection ──────────────────────────────────────────────────────

    match /users/{userId} {
      // Allow reading so that the registration page can check if a username is available
      allow read: if true;

      // [C-06 FIX] AI quota fields may only change via (a) a +1 increment with
      // the reset timestamp unchanged, or (b) a genuine daily reset — new usage
      // <= 1 AND at least 24h have elapsed since the previous reset. The old rule
      // allowed (dailyAiUsage:1, lastUsageReset:<any new ts>) with no time gate,
      // which let a client reset their quota to 1 at will. Now time-gated.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBanned', 'isSuspended', 'isVerified'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reputationPoints', 'contributorRank'])
              || request.resource.data.reputationPoints >= resource.data.reputationPoints)
          && (!isAttemptingAiQuotaWrite()
              || (request.resource.data.dailyAiUsage == resource.data.dailyAiUsage + 1
                  && request.resource.data.lastUsageReset == resource.data.lastUsageReset)
              || (request.resource.data.dailyAiUsage <= 1
                  && request.resource.data.lastUsageReset is timestamp
                  && resource.data.lastUsageReset is timestamp
                  && request.resource.data.lastUsageReset > resource.data.lastUsageReset + duration.value(24, 'h'))))
        ||
        (request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
          && (request.resource.data.followersCount == resource.data.followersCount + 1 || request.resource.data.followersCount == resource.data.followersCount - 1))
      );

      // [C-02 FIX] Harden create: a user may only create their OWN doc, and
      // may NOT self-assign a privileged role or pre-set moderation/reputation
      // fields. This closes the delete-then-recreate privilege-escalation path.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && (!('role' in request.resource.data) || request.resource.data.role == 'learner')
                    && (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false)
                    && (!('isSuspended' in request.resource.data) || request.resource.data.isSuspended == false)
                    && (!('reputationPoints' in request.resource.data) || request.resource.data.reputationPoints == 0);

      // [C-02 FIX] Clients may no longer hard-delete their user doc (which
      // allowed a clean recreate with an escalated role). Deletion is handled
      // via the deletionRequests collection + admin review.
      allow delete: if false;

      match /chatHistory/{messageId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /enrolledCourses/{courseId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ── Banners Collection ───────────────────────────────────────────────────

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrModerator();
    }

    // ── Courses Collection ───────────────────────────────────────────────────

    match /courses/{courseId} {
      allow read: if true;
      // Writes are admin-only. This was previously `if true` so the startup
      // seeder could run unauthenticated, which let any client on the internet
      // overwrite the course catalogue. The seeder no longer runs on startup.
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Colleges Collection ──────────────────────────────────────────────────

    match /colleges/{collegeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Notes Collection ─────────────────────────────────────────────────────
    // [H-01 FIX] Replaced blanket `allow write` with granular permissions.

    match /notes/{noteId} {
      allow read: if isSignedIn() && (
        resource.data.status == 'approved' ||
        resource.data.uploadedBy == request.auth.uid ||
        isAdminOrModerator()
      );

      allow create: if isSignedIn()
                    && request.resource.data.uploadedBy == request.auth.uid
                    && (request.resource.data.status == 'pending' || isAdmin())
                    && validStringField('title', 120)
                    && validStringField('subject', 100);

      allow update: if isSignedIn() &&
                    (
                      (resource.data.uploadedBy == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'uploadedBy', 'fileHash', 'pdfUrl', 'likes', 'downloads', 'reports', 'qualityScore']))
                      || isAdminOrModerator()
                    );

      allow delete: if isSignedIn() &&
                    (resource.data.uploadedBy == request.auth.uid || isAdminOrModerator());
    }

    // ── Question Papers Collection ────────────────────────────────────────────
    // [C-01 FIX] Removed contributor-role gating per user decision. Any signed-in
    // user may upload papers (pending approval), matching the notes flow.

    match /questionPapers/{paperId} {
      allow read: if resource.data.status == 'approved' || isAdminOrModerator();
      allow create: if isSignedIn()
                    && request.resource.data.uploadedBy == request.auth.uid
                    && (request.resource.data.status == 'pending' || isAdmin())
                    && validStringField('title', 120)
                    && validStringField('subject', 100);
      allow update, delete: if isAdminOrModerator();
    }

    // ── Community Posts Collection ────────────────────────────────────────────
    // [C-01 FIX] Removed contributor-role gating per user decision. Any signed-in
    // user may post, with basic field/size validation to maintain quality.

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && validStringField('content', 2000)
                    && request.resource.data.keys().hasAll(['authorId', 'content', 'createdAt']);
      allow update: if isSignedIn()
                    && (resource.data.authorId == request.auth.uid || isAdminOrModerator());
      allow delete: if isAdminOrModerator()
                    || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // ── Reposts Collection ───────────────────────────────────────────────────
    // [H-02 FIX] Added ownership validation.

    match /reposts/{repostId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── Comments Collection ───────────────────────────────────────────────────
    // [M-04 FIX] Required field validation and max-length enforcement.

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && validStringField('content', 500)
                    && request.resource.data.keys().hasAll(['authorId', 'contentId', 'content']);
      allow delete: if isSignedIn()
                    && (resource.data.authorId == request.auth.uid || isAdminOrModerator());
      allow update: if false;
    }

    // ── Likes Collection ─────────────────────────────────────────────────────

    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ── Followers Collection ──────────────────────────────────────────────────

    match /followers/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.followerId == request.auth.uid;
    }

    // ── Bookmarks Collection ──────────────────────────────────────────────────

    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── Blocks Collection ─────────────────────────────────────────────────────
    // [L-01 FIX] Added explicit rules for blocks collection.

    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // ── Reports Collection ────────────────────────────────────────────────────
    // [M-05 FIX] Required field validation for reports.

    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.keys().hasAll(['reporterId', 'contentId', 'contentType', 'reason'])
                    && validStringField('reason', 500);
      allow read, update, delete: if isAdminOrModerator();
    }

    // ── Notifications Collection ──────────────────────────────────────────────

    match /notifications/{notificationId} {
      // Allow reading a specific notification only if you are the receiver
      // Allow listing/querying notifications if signed in (query is filtered by receiverId in the app)
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && resource.data.receiverId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.receiverId == request.auth.uid;
    }

    match /global_notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrModerator();
    }


    // ── Admin Logs Collection ────────────────────────────────────────────────

    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Location Data ────────────────────────────────────────────────────────

    match /states/{stateId} {
      allow read: if true;
    }
    match /districts/{districtId} {
      allow read: if true;
    }
    match /talukas/{talukaId} {
      allow read: if true;
    }
    match /locations/{docId} {
      allow read: if true;
    }

    // ── AI History (legacy flat collection) ───────────────────────────────────

    match /aiHistory/{docId} {
      allow read, write: if false;
    }

    // ── Support Tickets ───────────────────────────────────────────────────────

    match /supportTickets/{ticketId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && validStringField('message', 2000);
      allow read, update, delete: if isAdmin();
    }

    // ── Deletion Requests ─────────────────────────────────────────────────────

    match /deletionRequests/{reqId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // ── Moderation Logs ───────────────────────────────────────────────────────

    match /moderationLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}

