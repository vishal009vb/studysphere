# AI Scraper environment variables
# Copy this file to ai_scraper/.env and fill in your values.
# NEVER commit your actual .env file.

# SerpAPI key (free tier: 100 searches/month)
# Get one at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Google Custom Search API (100 free queries/day)
# Create an API key at: https://console.developers.google.com/
# Create a Custom Search Engine at: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CX=your_search_engine_id_here

# Supabase (same values as the main app)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
